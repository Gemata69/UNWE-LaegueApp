@page
@model UNWE_LaegueApp.Pages.Admin.AdminIndexModel
@{
    ViewData["Title"] = "Admin - Управление на отбори";
}

<link rel="stylesheet" href="~/css/adminIndex.css" asp-append-version="true" />

<main class="admin-main-container">
    
    <header class="dashboard-header">
        <h1 class="admin-page-title">
            <span aria-hidden="true"></span> Admin Контролен Панел
        </h1>
        
        <a asp-page="./CreateLeague" class="create-league-btn">
            <span aria-hidden="true"></span> Създай нова Лига
        </a>
    </header>
    
    <div class="table-responsive-wrapper" tabindex="0" aria-label="Списък с всички регистрирани отбори">
        <table class="admin-table">
            <thead>
                <tr>
                    <th scope="col">Име на отбор</th>
                    <th scope="col">Капитан</th>
                    <th scope="col" class="text-center">Брой играчи</th>
                    <th scope="col" class="text-right">Действия</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Teams.Any())
                {
                    <tr>
                        <td colspan="4" class="empty-table-msg">
                            Все още няма регистрирани отбори в системата.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var team in Model.Teams)
                    {
                        <tr class="row-card">
                            <td class="cell-primary">
                                <a href="/TeamView/@team.Id" class="team-link">
                                    <i class="fas fa-shield-alt" aria-hidden="true"></i> @team.Name
                                </a>
                            </td>
                            <td>
                                <span class="captain-name">@(team.Captain?.Name ?? "Няма назначен")</span>
                            </td>
                            <td class="text-center">
                                <span class="player-count-badge">@team.Players.Count</span>
                            </td>
                            <td class="text-right">
                                <form method="post" asp-page-handler="DeleteTeam" class="delete-form" onsubmit="return confirm('СИГУРНИ ЛИ СТЕ? Това ще изтрие отбор @team.Name завинаги!');">
                                    <input type="hidden" name="teamId" value="@team.Id" />
                                    <button type="submit" class="action-delete-btn" aria-label="Изтрий отбор @team.Name завинаги">
                                        <i class="fas fa-trash-alt" aria-hidden="true"></i> Изтрий
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</main>