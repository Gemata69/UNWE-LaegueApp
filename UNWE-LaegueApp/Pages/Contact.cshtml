@page
@model UNWE_LaegueApp.Pages.ContactModel
@{
    ViewData["Title"] = "Контакти";
}

<style>
    .contact-container {
        max-width: 1200px;
        margin: 3rem auto;
        padding: 0 20px;
        font-family: 'Inter', sans-serif;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        align-items: start;
    }

    .map-wrapper {
        background-color: #001B3A;
        border-radius: 12px;
        padding: 10px;
        border: 1px solid rgba(56, 189, 248, 0.2);
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        height: 500px;
    }

    .map-wrapper iframe {
        width: 100%;
        height: 100%;
        border-radius: 8px;
        border: none;
    }

    .contact-form-card {
        background-color: #001B3A;
        border-radius: 12px;
        padding: 2.5rem;
        border: 1px solid rgba(56, 189, 248, 0.2);
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }

    .contact-title {
        color: #FFFFFF;
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .form-group { margin-bottom: 1.5rem; }

    .form-label {
        display: block;
        color: #FFFFFF;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .custom-input, .custom-textarea {
        width: 100%;
        background-color: #050505;
        color: #FFFFFF;
        border: 2px solid rgba(255, 255, 255, 0.15);
        padding: 12px 15px;
        border-radius: 8px;
        font-size: 1rem;
        transition: all 0.3s;
    }

    .custom-input:focus, .custom-textarea:focus {
        outline: none;
        border-color: #38BDF8;
        box-shadow: 0 0 10px rgba(56, 189, 248, 0.3);
    }

    .submit-btn {
        width: 100%;
        background: linear-gradient(90deg, #0284C7, #0369A1);
        color: #FFFFFF;
        border: none;
        padding: 15px;
        font-size: 1.1rem;
        font-weight: 800;
        text-transform: uppercase;
        border-radius: 8px;
        cursor: pointer;
        transition: transform 0.2s;
    }

    .submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(2, 132, 199, 0.4);
    }

    .text-success { color: #4ADE80; font-weight: 700; margin-bottom: 1rem; }

    @@media (max-width: 900px) {
        .contact-grid { grid-template-columns: 1fr; }
        .map-wrapper { order: 2; height: 350px; }
    }
</style>

<main class="contact-container">
    <div class="contact-grid">
        
 <section class="map-wrapper" aria-label="Местоположение на спортен комплекс Бонсист">
    <iframe 
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2934.5028045610214!2d23.352458476566023!3d42.65068291670005!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x40aa84252a550d99%3A0x679468903c746761!2z0KHQv9C-0YDRgtC10L0g0LrQvtC80L_Qu9C10LrRgSAn0JHQvtC90YHQuNGB0YIn!5e0!3m2!1sbg!2sbg!4v1715764000000!5m2!1sbg!2sbg" 
        width="100%" 
        height="100%" 
        style="border:0;" 
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="no-referrer-when-downgrade">
    </iframe>
</section>

        <section class="contact-form-card">
            <h1 class="contact-title"><span aria-hidden="true">✉️</span> Свържете се с нас</h1>
            
            @if (TempData["MessageSent"] != null)
            {
                <p class="text-success" role="alert">✅ Вашето съобщение беше изпратено успешно!</p>
            }

            <form method="post">
                <div class="form-group">
                    <label class="form-label" for="Name">Вашето име</label>
                    <input type="text" id="Name" name="Name" class="custom-input" required />
                </div>

                <div class="form-group">
                    <label class="form-label" for="Email">Вашият Имейл</label>
                    <input type="email" id="Email" name="Email" class="custom-input" required />
                </div>

                <div class="form-group">
                    <label class="form-label" for="Subject">Тема</label>
                    <input type="text" id="Subject" name="Subject" class="custom-input" required />
                </div>

                <div class="form-group">
                    <label class="form-label" for="Message">Съобщение</label>
                    <textarea id="Message" name="Message" rows="5" class="custom-textarea" required></textarea>
                </div>

                <button type="submit" class="submit-btn">Изпрати имейл</button>
            </form>
        </section>

    </div>
</main>