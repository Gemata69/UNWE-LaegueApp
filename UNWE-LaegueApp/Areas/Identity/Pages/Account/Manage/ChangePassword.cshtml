@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Смяна на парола";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<style>
    
    .password-content-wrapper {
        margin-top: 0; 
    }

        .password-content-wrapper .form-card {
            background-color: #001B3A;
            border-radius: 12px;
            padding: 2.5rem;
            border: 1px solid rgba(56, 189, 248, 0.2);
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            margin-top: 0;
        }

        .password-content-wrapper .section-title {
            font-size: 1.8rem;
            font-weight: 800;
            color: #FFFFFF;
            margin-top: 0;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .password-content-wrapper .form-group {
            margin-bottom: 1.5rem;
        }

        .password-content-wrapper .form-label {
            display: block;
            font-weight: 700;
            color: #FFFFFF;
            margin-bottom: 0.6rem;
            font-size: 1rem;
        }

        .password-content-wrapper .input-wrapper {
            position: relative;
            width: 100%;
        }

        .password-content-wrapper .custom-input {
            width: 100%;
            background-color: #050505;
            color: #FFFFFF;
            border: 2px solid rgba(255, 255, 255, 0.2);
            padding: 14px 18px;
            font-size: 1.1rem;
            border-radius: 8px;
            min-height: 48px; 
            transition: all 0.3s ease;
        }

            .password-content-wrapper .custom-input:focus {
                outline: none;
                border-color: #38BDF8;
                box-shadow: 0 0 12px rgba(56, 189, 248, 0.4);
            }

        .password-content-wrapper .submit-btn {
            width: 100%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: linear-gradient(90deg, #0284C7, #0369A1);
            color: #FFFFFF;
            border: none;
            padding: 16px;
            font-size: 1.15rem;
            font-weight: 800;
            text-transform: uppercase;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            min-height: 48px;
        }

            .password-content-wrapper .submit-btn:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 25px rgba(2, 132, 199, 0.5);
                background: linear-gradient(90deg, #0369A1, #075985);
            }

        .password-content-wrapper .text-danger {
            color: #F87171 !important;
            font-size: 0.95rem;
            font-weight: 600;
            margin-top: 0.5rem;
            display: block;
        }
</style>

<div class="password-content-wrapper">
    <div class="form-card">
        <h2 class="section-title"><span aria-hidden="true"></span> @ViewData["Title"]</h2>

        <partial name="_StatusMessage" for="StatusMessage" />

        <form id="change-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            
            <div class="form-group">
                <label asp-for="Input.OldPassword" class="form-label">Текуща парола</label>
                <div class="input-wrapper">
                    <input asp-for="Input.OldPassword" class="custom-input" autocomplete="current-password" aria-required="true" placeholder="Въведете текущата си парола..." />
                </div>
                <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="Input.NewPassword" class="form-label">Нова парола</label>
                <div class="input-wrapper">
                    <input asp-for="Input.NewPassword" class="custom-input" autocomplete="new-password" aria-required="true" placeholder="Въведете новата си парола..." />
                </div>
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="Input.ConfirmPassword" class="form-label">Потвърди новата парола</label>
                <div class="input-wrapper">
                    <input asp-for="Input.ConfirmPassword" class="custom-input" autocomplete="new-password" aria-required="true" placeholder="Потвърдете новата си парола..." />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            
            <button type="submit" class="submit-btn mt-3">
                <span aria-hidden="true"></span> Обнови паролата
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}