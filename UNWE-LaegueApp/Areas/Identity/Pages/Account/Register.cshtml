@page
@model RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />

<main class="auth-main-container">
    <div class="auth-card">
        
        <header class="auth-header">
            <h1 class="auth-title">
                <span aria-hidden="true"></span> Създай профил
            </h1>
            <p class="auth-subtitle">Стани част от най-добрата университетска лига!</p>
        </header>

        <div class="auth-body @(Model.ExternalLogins?.Count > 0 ? "auth-split" : "")">
            
            <section class="auth-local">
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="auth-form">
                    
                    <div asp-validation-summary="ModelOnly" class="error-summary"></div>

                    <div class="form-group">
                        <label asp-for="Input.Email" class="form-label">Имейл</label>
                        <div class="input-wrapper">
                            <i class="fas fa-envelope input-icon" aria-hidden="true"></i>
                            <input asp-for="Input.Email" class="custom-input" autocomplete="username" required placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Input.Email" class="error-text"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Password" class="form-label">Парола</label>
                        <div class="input-wrapper">
                            <i class="fas fa-lock input-icon" aria-hidden="true"></i>
                            <input asp-for="Input.Password" class="custom-input" autocomplete="new-password" required placeholder="Въведете сигурна парола..." />
                        </div>
                        <span asp-validation-for="Input.Password" class="error-text"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.ConfirmPassword" class="form-label">Потвърди Парола</label>
                        <div class="input-wrapper">
                            <i class="fas fa-check-double input-icon" aria-hidden="true"></i>
                            <input asp-for="Input.ConfirmPassword" class="custom-input" autocomplete="new-password" required placeholder="Повторете паролата..." />
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="error-text"></span>
                    </div>

                    <button id="registerSubmit" type="submit" class="submit-btn">
                        <i class="fas fa-user-plus" aria-hidden="true"></i> Регистрирай се
                    </button>

                    <div class="auth-links mt-3 text-center">
                        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="auth-link highlight-link">Вече имате профил? Влезте тук</a>
                    </div>
                </form>
            </section>

            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <div class="auth-divider">
                    <span aria-hidden="true">ИЛИ</span>
                </div>

                <section class="auth-external">
                    <h3 class="external-title">Регистрация чрез друга услуга</h3>
                    
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div class="external-buttons">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit" class="external-btn" name="provider" value="@provider.Name" aria-label="Регистрация чрез @provider.DisplayName">
                                    <i class="fab fa-@(provider.Name.ToLower()) external-icon" aria-hidden="true"></i> Продължи с @provider.DisplayName
                                </button>
                            }
                        </div>
                    </form>
                </section>
            }
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}